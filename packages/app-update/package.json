{
  "name": "@sch0718/app-update",
  "version": "0.0.0",
  "description": "배포 뒤 새 버전을 알아채 접속 직후면 자동으로 새로고침하고, 쓰는 중이면 안내만 한다. 안 본 릴리스 내용을 고른다.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "신춘호 (https://github.com/sch0718)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sch0718/sch0718-toolkit-web.git",
    "directory": "packages/app-update"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp ../../LICENSE LICENSE",
